# Balsm API — local build-time config template.
# Copy to .env (gitignored) and fill in real values. The EnvToAppSettings MSBuild
# task bakes these into src/Balsm.API/appsettings.Build.json at build time.
# Keys nest with `__` (Sentry__DSN -> Sentry:DSN). Runtime env vars override.

# Sentry error tracking / performance / profiling.
# Empty DSN disables Sentry (file logging still works).
Sentry__DSN=
Sentry__TracesSampleRate=0.1
Sentry__ProfilesSampleRate=0.0

# Local file logs.
Logs__Directory=var/logs
Logs__RetainedFileCountLimit=14
