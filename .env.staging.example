COMPOSE_PROJECT_NAME=balsm-api-stg
APP_DOMAIN=api-stg-balsm-health.mosalam.com
APP_PORT=8080
TRAEFIK_NETWORK=proxy
TRAEFIK_CERTRESOLVER=le
BALSM_INTERNAL_SUBNET=10.250.240.0/24

POSTGRES_DB=balsm_stg
POSTGRES_USER=balsm
POSTGRES_PASSWORD=replace-with-a-strong-password

JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=balsm
JWT_AUDIENCE=balsm-app
OTP_HMAC_SECRET=replace-with-a-long-random-secret
DOB_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
RECOVERY_SECRET=replace-with-a-long-random-secret

# Social sign-in audiences. Empty values make Google/Apple token validation
# fail the audience check, so sign-in breaks with no config error at startup.
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

RESEND_API_KEY=
RESEND_FROM=Balsm <noreply@balsm.health>

# Magic sign-in link: the emailed https link (OTP_LINK_BASE_URL/auth/otp/link)
# 302-redirects to the app. OTP_APP_LINK_SCHEME drives the native deep link;
# OTP_WEB_APP_URL (when set) is the Flutter-web fallback target.
OTP_LINK_BASE_URL=https://api-stg-balsm-health.mosalam.com
OTP_APP_LINK_SCHEME=balsm
OTP_WEB_APP_URL=

SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0
