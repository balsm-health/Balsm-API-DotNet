# GENERATED by scripts/config-sync.py from config/manifest.yaml — do not edit.
# Regenerate: python3 scripts/config-sync.py --write
#
# Secrets are blank here on purpose. On a fresh deploy bootstrap-staging-env.sh
# mints the generated ones; the rest arrive from GitHub secrets at deploy time.

# ---- docker compose only -------------------------------------------
COMPOSE_PROJECT_NAME=balsm-api-stg
# traefik Host() rule and the deploy health check
APP_DOMAIN=api-stg-balsm-health.mosalam.com
APP_PORT=8080
TRAEFIK_NETWORK=proxy
TRAEFIK_CERTRESOLVER=le
BALSM_INTERNAL_SUBNET=10.250.240.0/24
POSTGRES_DB=balsm_stg
POSTGRES_USER=balsm
# composed into Database__ConnectionString by compose; rotating breaks the
# volume
POSTGRES_PASSWORD=

# ---- application config (.NET keys, ':' -> '__') -------------------
Jwt__Secret=
Otp__HmacSecret=
Recovery__Secret=
# AES-256-GCM key for the one cloud PHI field (FR-048). Rotating orphans
# ciphertext.
DobEncryption__Key=
# AES-256-GCM key for care-team cloud PHI (FR-502). MUST differ from
# DobEncryption__Key so rotating or compromising one does not reach the other.
# 32 bytes, base64. Rotating orphans every stored care-team row.
CareTeamEncryption__Key=
# empty makes OtpService log the code instead of sending it — see forbidden
# Otp:DevCode
Resend__ApiKey=
Sentry__DSN=
# the WEB client id (serverClientId) — ID token 'aud', not the Android/iOS
# client
Google__ClientId=
# bundle id, for the native iOS flow
Apple__ClientId=app.balsm.health
# required by AppleRevokeService for deletion token revoke
Apple__TeamId=
# required by AppleRevokeService for deletion token revoke
Apple__KeyId=
# PKCS8 PEM. Required by AppleRevokeService; revoke no-ops while unset.
Apple__PrivateKey=
Jwt__Issuer=balsm
Jwt__Audience=balsm-app
Resend__From=Balsm <noreply@balsm.health>
# base of the emailed magic link; outlives the host it names, so prefer a
# domain you own
Otp__LinkBaseUrl=https://api-stg-balsm-health.mosalam.com
Otp__AppLinkScheme=balsm
# Flutter-web fallback for the magic link; unset disables it
Otp__WebAppUrl=
Sentry__TracesSampleRate=0.1
Sentry__ProfilesSampleRate=0.0
# without this, staging and local-dev events are indistinguishable in one
# project
Sentry__Environment=staging
# empty is valid — no distributed cache
Redis__ConnectionString=

# ---- literal env names read by the app -----------------------------
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
MAP_PACKS_CDN_BASE_URL=
MAP_PACKS_EXPORT_CRON=
