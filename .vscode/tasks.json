{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": ["build", "--configuration", "Release"],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "test",
      "command": "dotnet",
      "type": "process",
      "args": ["test", "--configuration", "Release", "--verbosity", "normal"],
      "problemMatcher": "$msCompile",
      "group": "test"
    },
    {
      "label": "clean",
      "command": "dotnet",
      "type": "process",
      "args": ["clean", "--configuration", "Release"],
      "problemMatcher": "$msCompile",
      "detail": "Remove bin/obj output from all projects"
    },
    {
      "label": "lint",
      "command": "dotnet",
      "type": "process",
      "args": ["format", "--verify-no-changes", "--verbosity", "diagnostic"],
      "problemMatcher": []
    },
    {
      "label": "admin-ui: install",
      "type": "shell",
      "command": "npm install",
      "options": { "cwd": "${workspaceFolder}/admin-ui" },
      "problemMatcher": [],
      "detail": "Install admin panel npm dependencies"
    },
    {
      "label": "admin-ui: build",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}/admin-ui" },
      "dependsOn": ["admin-ui: install"],
      "problemMatcher": [],
      "detail": "Build React admin panel → wwwroot/admin/"
    },
    {
      "label": "admin-ui: dev",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/admin-ui" },
      "isBackground": true,
      "problemMatcher": [],
      "detail": "Vite dev server with HMR (proxies API to localhost:5050)"
    },
    {
      "label": "run-api",
      "command": "dotnet",
      "type": "process",
      "args": [
        "run",
        "--project",
        "src/Balsam.API/Balsam.API.csproj"
      ],
      "problemMatcher": "$msCompile",
      "isBackground": true,
      "detail": "Starts the API on :5000 (includes admin panel at /admin in Standalone mode)"
    },
    {
      "label": "publish",
      "type": "shell",
      "command": "bash scripts/publish-all.sh $(echo '${input:platform}' | grep -oE '[a-z]+-[a-z0-9]+')",
      "problemMatcher": "$msCompile",
      "group": "build",
      "detail": "Cloud build — API only"
    },
    {
      "label": "publish-standalone",
      "type": "shell",
      "command": "bash scripts/publish-standalone.sh $(echo '${input:platform}' | grep -oE '[a-z]+-[a-z0-9]+')",
      "dependsOn": ["admin-ui: build"],
      "problemMatcher": "$msCompile",
      "group": "build",
      "detail": "Standalone build — single executable with embedded admin panel"
    },
    {
      "label": "build-installer",
      "type": "shell",
      "command": "bash ${input:installer} ${input:version} ${input:binding}",
      "problemMatcher": [],
      "group": "build"
    }
  ],
  "inputs": [
    {
      "id": "platform",
      "description": "Select target platform",
      "type": "pickString",
      "options": [
        {
          "label": "macOS (Apple Silicon)",
          "value": "osx-arm64"
        },
        {
          "label": "Windows (x64)",
          "value": "win-x64"
        },
        {
          "label": "Linux (x64)",
          "value": "linux-x64"
        },
        {
          "label": "All Platforms",
          "value": "osx-arm64 win-x64 linux-x64"
        }
      ],
      "default": "macOS (Apple Silicon)"
    },
    {
      "id": "binding",
      "description": "Select network binding mode",
      "type": "pickString",
      "options": [
        {
          "label": "Local only (localhost)",
          "value": "local"
        },
        {
          "label": "Public (0.0.0.0)",
          "value": "public"
        }
      ],
      "default": "Local only (localhost)"
    },
    {
      "id": "version",
      "description": "Package version (leave default to use Directory.Build.props)",
      "type": "promptString",
      "default": "0.1.0"
    },
    {
      "id": "installer",
      "description": "Select installer platform",
      "type": "pickString",
      "options": [
        {
          "label": "macOS (.pkg)",
          "value": "packaging/macos/build-pkg.sh"
        },
        {
          "label": "Linux (.deb)",
          "value": "packaging/linux/build-deb.sh"
        }
      ],
      "default": "macOS (.pkg)"
    }
  ]
}
