<?xml version="1.0" encoding="utf-8"?>
<!--
  Coverage settings for the "XPlat Code Coverage" collector; CI passes this
  file to dotnet test (see .github/workflows/ci.yml).

  EF Core migrations are generated by `dotnet ef`, never edited by hand, and
  only run against a real database, so counting them only measures how many
  migrations a module has. They are left out: the migration-only assemblies
  (*.Migrations.Sqlite / *.Migrations.Npgsql) and the Migrations/ folders that
  sit inside an Infrastructure project. scripts/quality-bar.sh excludes the
  same files for the same reason.
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Exclude>[*.Migrations.Sqlite]*,[*.Migrations.Npgsql]*</Exclude>
          <ExcludeByFile>**/Migrations/*.cs</ExcludeByFile>
          <ExcludeByAttribute>GeneratedCodeAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
