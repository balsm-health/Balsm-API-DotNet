{
  "components": {
    "schemas": {
      "ProblemDetails": {
        "properties": {
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "format": "int32",
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "type": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "type": "object"
      },
      "UpsertCareProviderRequest": {
        "properties": {
          "address": {
            "type": [
              "null",
              "string"
            ]
          },
          "clinic": {
            "type": [
              "null",
              "string"
            ]
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "email": {
            "type": [
              "null",
              "string"
            ]
          },
          "health_profile_id": {
            "format": "uuid",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "map_url": {
            "type": [
              "null",
              "string"
            ]
          },
          "name": {
            "type": "string"
          },
          "notes": {
            "type": [
              "null",
              "string"
            ]
          },
          "phone": {
            "type": [
              "null",
              "string"
            ]
          },
          "phone2": {
            "type": [
              "null",
              "string"
            ]
          },
          "specialty": {
            "type": [
              "null",
              "string"
            ]
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "health_profile_id",
          "type",
          "name",
          "specialty",
          "phone",
          "phone2",
          "email",
          "clinic",
          "address",
          "map_url",
          "notes",
          "created_at"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "contact": {
      "name": "Balsm Platform",
      "url": "https://github.com/balsm-health/Balsm-API-DotNet"
    },
    "description": "The patient's own care team, cloud-mirrored. Field-encrypted PHI; every read is audited.",
    "title": "Balsm Care Team API",
    "version": "v1"
  },
  "openapi": "3.1.1",
  "paths": {
    "/care-team/health": {
      "get": {
        "operationId": "CareTeam_Health",
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "summary": "CareTeam module liveness probe",
        "tags": [
          "Health"
        ]
      }
    },
    "/care-team/providers": {
      "get": {
        "description": "Incremental sync feed. Tombstoned rows are returned with is_deleted=true so a delete on one device propagates to the others.",
        "operationId": "CareTeam_PullProviders",
        "parameters": [
          {
            "in": "query",
            "name": "health_profile_id",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "since",
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {}
            },
            "description": "OK"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Unauthorized"
          }
        },
        "summary": "Pull care-team rows changed since a cursor",
        "tags": [
          "CareTeam/Providers"
        ]
      },
      "post": {
        "description": "Idempotent on id so an at-least-once outbox drain cannot duplicate. A tombstoned id is refused with 409 rather than resurrected.",
        "operationId": "CareTeam_UpsertProvider",
        "requestBody": {
          "content": {
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/UpsertCareProviderRequest"
              }
            },
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpsertCareProviderRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {}
            },
            "description": "OK"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        },
        "summary": "Create or overwrite one care-team row",
        "tags": [
          "CareTeam/Providers"
        ]
      }
    },
    "/care-team/providers/{id}": {
      "delete": {
        "operationId": "CareTeam_DeleteProvider",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "content": {
              "application/json": {}
            },
            "description": "No Content"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Not Found"
          }
        },
        "summary": "Tombstone one care-team row",
        "tags": [
          "CareTeam/Providers"
        ]
      }
    }
  },
  "servers": [
    {
      "url": "http://127.0.0.1:5550/"
    }
  ],
  "tags": [
    {
      "name": "CareTeam/Providers"
    },
    {
      "name": "Health"
    }
  ]
}
