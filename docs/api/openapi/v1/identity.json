    "/api/v1/family-links": {
      "post": {
        "description": "Creates a pending link from the caller to the account that owns the scanned profile QR. The jti is resolved once; the link then binds to the two account ids.",
        "operationId": "Identity_CreateFamilyLink",
        "requestBody": {
          "content": {
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CreateFamilyLinkRequest"
              }
            },
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateFamilyLinkRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FamilyLinkResponse"
                }
              }
            },
            "description": "OK"
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FamilyLinkResponse"
                }
              }
            },
            "description": "Created"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FamilyLinkErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FamilyLinkErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FamilyLinkErrorResponse"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FamilyLinkErrorResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FamilyLinkErrorResponse"
                }
              }
            },
            "description": "Too Many Requests"
          }
        },
        "summary": "Request a family link by profile-QR jti",
        "tags": [
          "Identity/FamilyLinks"
        ]
      }
    },
    "/api/v1/family-links/incoming": {
      "get": {
        "description": "Newest first, paged. Filter with ?status=pending for open requests. Each item shows the requester's @handle and display name.",
