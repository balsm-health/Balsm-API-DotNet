      "put": {
        "description": "ECIES: X25519 + HKDF-SHA256 (info balsm-family-card-v1, salt = link id) + AES-256-GCM, AAD = link id | owner user id | version. The server stores the envelope only.",
        "operationId": "Identity_UpsertFamilyLinkCard",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/UpsertFamilyLinkCardRequest"
              }
            },
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpsertFamilyLinkCardRequest"
              }
            }
          },
          "required": true
        },
