[Unit]
Description=Balsam Supervisor (Admin Panel & API Manager)
After=network.target

[Service]
Type=notify
ExecStart=/opt/balsam/supervisor/Balsam.Supervisor
WorkingDirectory=/opt/balsam/supervisor
Environment=ASPNETCORE_ENVIRONMENT=Production
Restart=on-failure
RestartSec=10
User=balsam
Group=balsam
SyslogIdentifier=balsam-supervisor

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/balsam

[Install]
WantedBy=multi-user.target
