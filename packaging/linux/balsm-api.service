[Unit]
Description=Balsm Healthcare API Server
After=network.target

[Service]
Type=notify
ExecStart=/opt/balsm/api/Balsm.API
WorkingDirectory=/opt/balsm/api
Environment=ASPNETCORE_ENVIRONMENT=Production
Restart=on-failure
RestartSec=10
User=balsm
Group=balsm
SyslogIdentifier=balsm-api

# Allow binding privileged ports 80/443 while still running as the unprivileged
# 'balsm' user. Ambient caps are granted by systemd and coexist with NoNewPrivileges.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/balsm/api

[Install]
WantedBy=multi-user.target
