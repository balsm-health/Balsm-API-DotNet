#!/bin/bash
set -e

# Create service user if it does not exist
if ! id -u balsm >/dev/null 2>&1; then
    useradd --system --no-create-home --shell /usr/sbin/nologin balsm
fi

# Set ownership
chown -R balsm:balsm /opt/balsm/api

# Handle binding choice via environment variable
BINDING_MODE="${BALSM_BINDING_MODE:-local}"
CONFIG="/opt/balsm/api/appsettings.Production.json"

if [ ! -f "$CONFIG" ]; then
    if [ "$BINDING_MODE" = "public" ]; then
        URLS="http://0.0.0.0:5000"
    else
        URLS="http://localhost:5000"
    fi
    cat > "$CONFIG" << EOF
{
  "Server": { "Urls": "$URLS" },
  "Database": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=balsm.db"
  }
}
EOF
    chown balsm:balsm "$CONFIG"
fi

# Create logs directory
mkdir -p /opt/balsm/api/logs
chown balsm:balsm /opt/balsm/api/logs

# Enable and start service
systemctl daemon-reload
systemctl enable balsm-api
systemctl start balsm-api
