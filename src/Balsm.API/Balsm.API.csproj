<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <PublishTrimmed>false</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <!--
    OpenAPI specs are emitted by the running host at /openapi/v1/{document}.json and
    captured to docs/api/openapi/v1/ via scripts/generate-openapi.sh. Build-time
    emission via Microsoft.Extensions.ApiDescription.Server is disabled because the
    full host boots Supervisor / migrations / mDNS and exceeds the tool's timeout.
    Enable on-demand only: dotnet build /p:OpenApiGenerateDocumentsOnBuild=true
  -->
  <PropertyGroup>
    <OpenApiGenerateDocuments>false</OpenApiGenerateDocuments>
    <OpenApiGenerateDocumentsOnBuild>false</OpenApiGenerateDocumentsOnBuild>
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/../../docs/api/openapi/v1</OpenApiDocumentsDirectory>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Balsm.SharedKernel\Balsm.SharedKernel.csproj" />
    <ProjectReference Include="..\Balsm.Infrastructure\Balsm.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\Identity\Balsm.Identity.Api\Balsm.Identity.Api.csproj" />
    <ProjectReference Include="..\Modules\Identity\Balsm.Identity.Infrastructure\Balsm.Identity.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\Entity\Balsm.Entity.Api\Balsm.Entity.Api.csproj" />
    <ProjectReference Include="..\Modules\Entity\Balsm.Entity.Infrastructure\Balsm.Entity.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\Inventory\Balsm.Inventory.Api\Balsm.Inventory.Api.csproj" />
    <ProjectReference Include="..\Modules\Inventory\Balsm.Inventory.Infrastructure\Balsm.Inventory.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\POS\Balsm.POS.Api\Balsm.POS.Api.csproj" />
    <ProjectReference Include="..\Modules\POS\Balsm.POS.Infrastructure\Balsm.POS.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\Customer\Balsm.Customer.Api\Balsm.Customer.Api.csproj" />
    <ProjectReference Include="..\Modules\Customer\Balsm.Customer.Infrastructure\Balsm.Customer.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\Prescription\Balsm.Prescription.Api\Balsm.Prescription.Api.csproj" />
    <ProjectReference Include="..\Modules\Prescription\Balsm.Prescription.Infrastructure\Balsm.Prescription.Infrastructure.csproj" />
    <ProjectReference Include="..\Balsm.Supervisor\Balsm.Supervisor.csproj" />
  </ItemGroup>

</Project>
