{
  "Server": {
    "Urls": "http://0.0.0.0:80",
    "Mode": "network",
    "HttpsPort": 443
  },
  "Database": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=balsm.db"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": ["FromLogContext"]
  }
}
