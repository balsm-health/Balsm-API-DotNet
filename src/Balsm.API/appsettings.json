{
  "AllowedHosts": "*",
  "DeploymentMode": "Standalone",
  "Server": {
    "Urls": "http://0.0.0.0:5050"
  },
  "Database": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=balsm.db"
  },
  "CloudDatabase": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=balsm-cloud.db"
  },
  "Supervisor": {
    "GitHubRepository": "AskBalsm/Balsm-API-DotNet",
    "EnableMdns": true,
    "MdnsHostname": "balsm",
    "ConnectionInfoPath": "connection-info.txt",
    "FirstRunSentinelPath": ".first-run-done"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "Logs": {
    "Directory": "var/logs",
    "RetainedFileCountLimit": 14
  },
  "Sentry": {
    "DSN": "",
    "TracesSampleRate": 0.1,
    "ProfilesSampleRate": 0.0
  },
  "CareDirectory": {
    "ImportOnStartup": true,
    "MinConfidence": 0.65,
    "MinConfidenceByType": {
      "scan": 0.5
    }
  }
}
