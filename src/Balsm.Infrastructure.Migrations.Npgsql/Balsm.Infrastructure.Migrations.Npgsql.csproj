<Project Sdk="Microsoft.NET.Sdk">

  <!-- Npgsql migration set for PlatformDbContext. Selected at runtime via
       DatabaseServiceExtensions.ConfigureDatabase (MigrationsAssembly) when
       Database:Provider = postgresql. The SQLite set stays in Balsm.Infrastructure. -->

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Balsm.Infrastructure\Balsm.Infrastructure.csproj" />
  </ItemGroup>

</Project>
