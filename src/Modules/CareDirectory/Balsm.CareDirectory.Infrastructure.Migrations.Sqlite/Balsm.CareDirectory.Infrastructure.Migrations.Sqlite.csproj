<Project Sdk="Microsoft.NET.Sdk">

  <!-- SQLite migration set for CareDirectoryDbContext. Care directory is a
       LOCAL-only (balsm.db) NON-PHI module, so there is no Npgsql set. -->

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Balsm.CareDirectory.Infrastructure\Balsm.CareDirectory.Infrastructure.csproj" />
  </ItemGroup>

</Project>
