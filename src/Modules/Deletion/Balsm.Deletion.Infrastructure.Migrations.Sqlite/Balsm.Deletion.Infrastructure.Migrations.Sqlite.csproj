<Project Sdk="Microsoft.NET.Sdk">

  <!-- SQLite migration set for DeletionDbContext. The Npgsql set stays in
       Balsm.Deletion.Infrastructure; selected at runtime by CloudDatabase:Provider. -->

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Balsm.Deletion.Infrastructure\Balsm.Deletion.Infrastructure.csproj" />
  </ItemGroup>

</Project>
